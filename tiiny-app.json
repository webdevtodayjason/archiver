{
  "manifest": 1,
  "id": "archiver",
  "name": "Archiver",
  "tagline": "A shelf of PDFs, or your own notes, turned into something you can ask.",
  "author": {
    "name": "Jason Brashear",
    "github": "webdevtodayjason"
  },
  "license": "MIT",
  "repo": "https://github.com/webdevtodayjason/archiver",
  "categories": [
    "tools",
    "ocr",
    "knowledge"
  ],
  "needs": {
    "models": [
      {
        "id": "zai-org/GLM-OCR",
        "npu": 4,
        "role": "reads scanned pages, when the device serves it",
        "required": false,
        "managed": false,
        "alternatives": [
          "tesseract (local)",
          "paddleocr (local)"
        ]
      },
      {
        "id": "Qwen/Qwen3-Embedding-0.6B",
        "npu": 1,
        "role": "embeds chunks and questions, so the archive can be searched",
        "required": true,
        "managed": false
      },
      {
        "id": "Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice",
        "npu": 7,
        "role": "speaks the two hosts in an audio overview",
        "required": false,
        "managed": true,
        "alternatives": [
          "Qwen/Qwen3-TTS-12Hz-1.7B-Base"
        ]
      }
    ],
    "npu_resident": 1,
    "npu_peak": 8,
    "runtime": {
      "python": ">=3.9",
      "deps": []
    },
    "disk_mb": 200
  },
  "asks_for": [
    {
      "what": "disk",
      "why": "reads the PDFs you point it at and keeps the extracted text"
    },
    {
      "what": "device-key",
      "why": "only if you use the Tiiny as the OCR engine"
    },
    {
      "what": "network-lan",
      "why": "only to reach the Tiiny, or a shared corpus on another machine"
    }
  ],
  "provides": {
    "cli": "archiver",
    "app": "python3 cockpit.py"
  },
  "plant": {
    "get": "git clone https://github.com/webdevtodayjason/archiver",
    "run": "python3 archiver status",
    "check": "python3 cockpit.py --selfcheck"
  },
  "privacy": {
    "egress": "none",
    "telemetry": false,
    "stores": "Extracted text, page confidences and chunks, in SQLite beside the tool. Audio overviews are written beside it too, as a wav and the script that produced it."
  }
}
